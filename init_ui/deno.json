{
  "name": "init",
  "version": "1.0.23",
  "tasks": {
    "view": "deno run --allow-net --allow-read  --allow-run  --allow-env --allow-ffi --allow-sys jsr:@funxdata/toolkit/view",
    "pack": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env --allow-ffi --allow-sys jsr:@funxdata/toolkit/pack src/app.ts"
  },
  "imports": {
    "@funxdata/pages": "jsr:@funxdata/pages@^0.0.38",
    "@funxdata/pages/tplstype": "jsr:@funxdata/pages@^0.0.38/tplstype",
    "@funxdata/pages/routetype": "jsr:@funxdata/pages@^0.0.38/routtype",
    "@funxdata/toolkit": "jsr:@funxdata/toolkit@^0.2.22",
    "@funxdata/webdx": "jsr:@funxdata/webdx@^1.1.8",
    "@funxdata/webdx/dxhttp": "jsr:@funxdata/webdx@^1.1.8/dxhttp",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "nodeModulesDir": "auto"
}
